<?xml version="1.0" encoding="utf-8"?>
<form>
    <field name="id" type="hidden" />
    <field name="project_id" type="hidden" />
    <field name="name" 
           type="text" 
           label="COM_KJEHOLTBUSINESS_SUBPROJECT_FIELD_NAME_LABEL" 
           description="COM_KJEHOLTBUSINESS_SUBPROJECT_FIELD_NAME_DESC" 
           size="40" />
    <field name="description" 
           type="editor" 
           label="COM_KJEHOLTBUSINESS_SUBPROJECT_FIELD_DESCRIPTION_LABEL" 
           description="COM_KJEHOLTBUSINESS_SUBPROJECT_FIELD_DESCRIPTION_DESC" 
           filter="safehtml" 
           buttons="true" />
    <field name="sequence_id" 
           type="hidden" />

    <field name="start_date" 
           type="calendar" 
           label="COM_KJEHOLTBUSINESS_SUBPROJECT_FIELD_START_DATE_LABEL" 
           description="COM_KJEHOLTBUSINESS_SUBPROJECT_FIELD_START_DATE_DESC" 
           format="%Y-%m-%d" />          
    <field name="hourly_rate" 
           type="text" 
           filter="integer" 
           default="900" 
           label="COM_KJEHOLTBUSINESS_SUBPROJECT_FIELD_HOURLY_RATE_LABEL" 
           description="COM_KJEHOLTBUSINESS_SUBPROJECT_FIELD_HOURLY_RATE_DESC" />
    <field name="estimated_amount_of_hours" 
           type="text" 
           filter="integer" 
           default="0" 
           label="COM_KJEHOLTBUSINESS_SUBPROJECT_FIELD_ESTIMATED_HOURS_LABEL" 
           description="COM_KJEHOLTBUSINESS_SUBPROJECT_FIELD_ESTIMATED_HOURS_DESC" />
    <field name="rot" type="radio" label="COM_KJEHOLTBUSINESS_SUBPROJECT_FIELD_ROT_LABEL" default="0" filter="integer">
        <option value="0">JNO</option>
        <option value="1">JYES</option>
    </field>
    <field name="rut" type="radio" label="COM_KJEHOLTBUSINESS_SUBPROJECT_FIELD_RUT_LABEL" default="0" filter="integer">
        <option value="0">JNO</option>
        <option value="1">JYES</option>
    </field>
    <field name="vat" type="text" label="COM_KJEHOLTBUSINESS_SUBPROJECT_FIELD_VAT_LABEL" default="25" filter="float" />
    <field name="status" type="hidden" />
</form>

