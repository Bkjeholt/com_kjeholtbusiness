<?xml version="1.0" encoding="utf-8"?>
<form name="projectFormName">
    <fieldset name="mainFieldset" 
              label="mainFieldsetLabel" 
              description="mainFieldsetDescription">
        <field name="project_id" 
               type="hidden" />
        <field name="project_status" 
               type="hidden" />
        <field name="company_id" 
               type="hidden" />
        <field name="project_name" 
               type="text" 
               label="COM_KJEHOLTBUSINESS_PROJECT_FIELD_NAME_LABEL" 
               description="COM_KJEHOLTBUSINESS_PROJECT_FIELD_NAME_DESC" 
               required="true" 
               size="40" />
        <field name="project_description" 
               type="editor" 
               label="COM_KJEHOLTBUSINESS_PROJECT_FIELD_DESCRIPTION_LABEL" 
               description="COM_KJEHOLTBUSINESS_PROJECT_FIELD_DESCRIPTION_DESC" 
               filter="safehtml" 
               buttons="true" />
        <field name="property_name" type="text" label="COM_KJEHOLTBUSINESS_PROJECT_FIELD_PROPERTY_NAME_LABEL" description="COM_KJEHOLTBUSINESS_PROJECT_FIELD_PROPERTY_NAME_DESC" required="true" size="40" />
        <field name="start_date" type="calendar" label="COM_KJEHOLTBUSINESS_PROJECT_FIELD_START_DATE_LABEL" description="COM_KJEHOLTBUSINESS_PROJECT_FIELD_START_DATE_DESC" format="%Y-%m-%d" />
        <field name="customer_subfields" 
               type="subform"
               min="1"
               formsource="components/com_kjeholtbusiness/forms/customer.xml" 
               multiple="false"
               label="COM_KJEHOLTBUSINESS_PROJECT_FIELD_CUSTOMER_SUBFORM_LABEL" 
               description="COM_KJEHOLTBUSINESS_PROJECT_FIELD_CUSTOMER_SUBFORM_LABEL" />
 
        <field name="subproject_subfields" 
               type="subform"
               min="1"
               formsource="components/com_kjeholtbusiness/forms/subproject.xml" 
               multiple="true"
               label="COM_KJEHOLTBUSINESS_PROJECT_FIELD_SUBPROJECT_SUBFORM_LABEL" 
               description="COM_KJEHOLTBUSINESS_PROJECT_FIELD_SUBPROJECT_SUBFORM_LABEL" />
    </fieldset>
 
 
</form>

