 <?xml version="1.0" encoding="utf-8"?>
 <form name="timeReportingStartFormName">
    <fieldset name="mainFieldset" 
              label="mainFieldsetLabel" 
              description="mainFieldsetDescription">
       <field name="timereporting_id" 
              type="hidden" />
       <field name="subproject_id"
              type="sql" />
       <field name="timereporting_name" 
              type="text" 
              label="COM_KJEHOLTBUSINESS_TIMEREPORTING_FIELD_NAME_LABEL" 
              description="COM_KJEHOLTBUSINESS_TIMEREPORTING_FIELD_NAME_DESC" 
              required="true" 
              size="40" />
       <field name="timereporting_date" 
              type="calendar" 
              label="COM_KJEHOLTBUSINESS_TIMEREPORTING_FIELD_DATE_LABEL" 
              description="COM_KJEHOLTBUSINESS_TIMEREPORTING_FIELD_DATE_DESC" 
              format="%Y-%m-%d" />
       <field name="timereporting_start"	
              type="time" 
              min="00:00"
              max="23:59"
              label="COM_KJEHOLTBUSINESS_TIMEREPORTING_FIELD_START_LABEL" 
              description="COM_KJEHOLTBUSINESS_TIMEREPORTING_FIELD_START_DESC" />
    </fieldset>
 </form>