            <action name="expency.edit" title="COM_KJEHOLTBUSINESS_ACTION_EDIT_EXPENCY" description="COM_KJEHOLTBUSINESS_ACTION_EDIT_EXPENCY_DESC"/>
            <action name="expency.delete" title="COM_KJEHOLTBUSINESS_ACTION_DELETE_EXPENCY" description="COM_KJEHOLTBUSINESS_ACTION_DELETE_EXPENCY_DESC"/>
            <action name="expency.view" title="COM_KJEHOLTBUSINESS_ACTION_VIEW_EXPENCY" description="COM_KJEHOLTBUSINESS_ACTION_VIEW_EXPENCY_DESC"/>
        </section>
    </access>

    <!-- Konfiguration -->
    <config>
    </config>
