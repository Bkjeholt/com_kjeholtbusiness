            <action name="project.view" title="COM_KJEHOLTBUSINESS_ACTION_VIEW_PROJECT" description="COM_KJEHOLTBUSINESS_ACTION_VIEW_PROJECT_DESC"/>
        </section>
        <section name="subproject">
            <action name="subproject.create" title="COM_KJEHOLTBUSINESS_ACTION_CREATE_SUBPROJECT" description="COM_KJEHOLTBUSINESS_ACTION_CREATE_SUBPROJECT_DESC"/>
            <action name="subproject.edit" title="COM_KJEHOLTBUSINESS_ACTION_EDIT_SUBPROJECT" description="COM_KJEHOLTBUSINESS_ACTION_EDIT_SUBPROJECT_DESC"/>
            <action name="subproject.delete" title="COM_KJEHOLTBUSINESS_ACTION_DELETE_SUBPROJECT" description="COM_KJEHOLTBUSINESS_ACTION_DELETE_SUBPROJECT_DESC"/>
            <action name="subproject.view" title="COM_KJEHOLTBUSINESS_ACTION_VIEW_SUBPROJECT" description="COM_KJEHOLTBUSINESS_ACTION_VIEW_SUBPROJECT_DESC"/>
        </section>
        <section name="expency">
